{
  "name": "hex-aram",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app that announces funny/insightful League of Legends match commentary to a Discord server (text + TTS voice) when a game ends.",
  "type": "commonjs",
  "main": "dist/src/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Martin-Ocean/mayhem.git"
  },
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev:renderer": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock-lcu": "ts-node scripts/mock-lcu-server.ts",
    "replay": "ts-node scripts/replay-fixture.ts",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "discord.js": "^14.15.3",
    "ffmpeg-static": "^5.2.0",
    "league-connect": "^5.5.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "express": "^4.19.2",
    "lucide-react": "^1.41.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.21",
    "vitest": "^1.6.0"
  },
  "build": {
    "appId": "com.hexaram.app",
    "productName": "Hex ARAM",
    "files": [
      "dist/**/*",
      "fixtures/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "publish": {
      "provider": "github",
      "owner": "Martin-Ocean",
      "repo": "mayhem"
    }
  }
}
